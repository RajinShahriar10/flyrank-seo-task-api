# Copy this file to .env before running `docker compose up`.
# Host "db" is the compose service name; use "localhost" when running the app
# directly on your machine with a separately published Postgres port.
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://tasks:tasks@db:5432/tasks

# Postgres container credentials (compose substitutes these from .env)
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks

# Optional stretch: Redis. Remove this line to run without the cache service.
REDIS_URL=redis://cache:6379/0
